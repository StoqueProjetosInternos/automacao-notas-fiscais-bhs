{
  "name": "stoque-fiscal-intelligence-desktop",
  "version": "1.0.0",
  "description": "Stoque Fiscal Intelligence - Aplicação Desktop Electron",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build:main": "tsc",
    "build:dashboard": "npm --workspace=stoque-fiscal-intelligence-dashboard run build",
    "build:automacao": "npm --workspace=stoque-fiscal-intelligence run build",
    "dev": "npm run build:automacao && npm run build:dashboard && npm run build:main && electron .",
    "dist": "npm run build:automacao && npm run build:dashboard && npm run build:main && electron-builder",
    "pack": "npm run build:automacao && npm run build:dashboard && npm run build:main && electron-builder --dir"
  },
  "keywords": [
    "electron",
    "stoque",
    "fiscal",
    "intelligence"
  ],
  "author": "Stoque",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.6",
    "nodemailer": "^6.9.14",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-text": "^0.0.7",
    "pdf.js-extract": "^0.2.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.2",
    "@types/node": "^25.5.0"
  },
  "build": {
    "electronVersion": "33.2.1",
    "appId": "br.com.stoque.fiscalintelligence",
    "productName": "Stoque Fiscal Intelligence",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      {
        "from": "../automacao/dist",
        "to": "automacao/dist"
      },
      {
        "from": "../dashboard/dist",
        "to": "dashboard/dist"
      }
    ],
    "extraResources": [
      {
        "from": "../../data",
        "to": "data"
      },
      {
        "from": "../../cr.json",
        "to": "cr.json"
      },
      {
        "from": "../../naturezas.json",
        "to": "naturezas.json"
      },
      {
        "from": "../../.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
