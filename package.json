{
  "name": "stoque-fiscal-intelligence-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w stoque-fiscal-intelligence",
    "dev-api": "npm run dev-api -w stoque-fiscal-intelligence",
    "dev:desktop": "npm --workspace=stoque-fiscal-intelligence-desktop run dev",
    "dev:live": "npx concurrently \"npm --workspace=stoque-fiscal-intelligence-dashboard run dev\" \"npm --workspace=stoque-fiscal-intelligence-desktop run dev\"",
    "build:desktop": "npm --workspace=stoque-fiscal-intelligence-desktop run dist",
    "usage": "npm run usage -w stoque-fiscal-intelligence",
    "go": "npx tsx apps/automacao/src/server/index.ts"
  }
}